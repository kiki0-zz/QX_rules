#!name=滴滴出行去广告 (禁反弹终极版 v5)
#!desc=彻底封锁滴滴通过备用通道拉取广告的可能性。
#!author=kiki
#!tag=去广告
#!loon_version=3.2.4(787)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DiDi.png

[Rule]
# 1. 封杀滴滴已知的 HTTPDNS 调度（防止它绕过域名重定向）
DOMAIN, httpdns.xiaojukeji.com, REJECT
DOMAIN, amap-proxy.jd.com, REJECT

# 2. 封杀 UDP 443 (QUIC) 协议（很多反弹是通过 QUIC 协议绕过常规拦截的）
AND, ((PROTOCOL, UDP), (DEST-PORT, 443)), REJECT

# 3. 拦截滴滴各种营销活动/广告域名（直接拒绝，不给它恢复的机会）
DOMAIN, gwp.xiaojukeji.com, REJECT
DOMAIN, ad-v.xiaojukeji.com, REJECT
DOMAIN, dpm.xiaojukeji.com, REJECT

[Rewrite]
# 核心：对那些容易导致反弹的请求，直接返回空字典，而不是修改它
^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/slow\? reject-dict
^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf reject-dict
^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds\? reject-dict
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget reject-dict

# 针对主页布局，不做复杂的 JQ 过滤（容易崩），直接删除最显眼的广告位字段
^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/dache_homepage_layout\? response-body-json-del data.instances.dache_main_marketing_card data.instances.dache_main_super_banner_card data.instances.dache_main_activity_card

# 订单显示修正（这次不做过滤，直接原样放行这些关键接口，确保订单万无一失）
# ^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/pSFCHomePage\? (已移除拦截)

[MitM]
# 简化主机名，重点针对 API 和 CONF
hostname = conf.diditaxi.com.cn, api.udache.com, common.diditaxi.com.cn, res.xiaojukeji.com, ct.xiaojukeji.com
