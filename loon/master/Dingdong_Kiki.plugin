#!name=叮咚买菜去广告 · Kiki 兼容版
#!desc=保留折扣、优惠券及购物入口；针对开屏、启动弹窗和首页顶部大横幅做响应净化，不整页拦截。
#App链接=https://apps.apple.com/app/id768082524
#!author=kiki0-zz（参考可莉、zirawell、奶思公开规则）
#!tag=去广告
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DingdongMaicai.png
#!homepage=https://github.com/kiki0-zz/QX_rules/blob/main/loon/master/Dingdong_Kiki.plugin
#!loon_version=3.5.1(978)
#!date=2026-11-14

# Kiki Dingdong v1.1 | 定点净化开屏/启动弹窗/顶部横幅 / 保留折扣与促销 / 无远程 JS
# 目标：移除开屏广告、启动后营销弹窗、首页顶部大横幅。
# 特别保留：首页「满29元领券包」、会员折扣、限时优惠、搜索热词、
# 商品推荐、购物车、订单、我的页面全部入口、底部导航及领券路径。
# 与旧版区别：不 REJECT 业务请求，不删整页数据、功能入口和购物推荐，
# 不拦 CDN/追踪/HTTPDNS 域名，也不拦 queryMyPage/homeFlowDetail。
# v1.1 添加两个“广告专用接口”的响应净化：只清空广告 payload，
# 保留原响应 code / message / success 等顶层字段，降低错误弹窗概率。
# 注意：清空广告响应的数据结构是根据公开接口用途设计的，尚未抓取
# 你的当前 App 响应验证；若有网络弹窗，应停用并查看 Loon 请求记录。
# 如果旧开屏素材已缓存，可能要清除 App 缓存后才会完全消失。
# 启用前关闭旧可莉/其他叮咚去广告插件，避免多套重写互相影响。
#
# 参考（只借鉴已知接口，不沿用激进的 REJECT）：
# https://github.com/fkingikelee/fkikelee/blob/main/lpx/DingdongMaicai_remove_ads.lpx
# https://github.com/fmz200/wool_scripts/blob/main/Loon/plugin/split/partD/DingDongMaiCai.lpx
# https://github.com/zirawell/R-Store/blob/main/Res/Scripts/AntiAd/ddxq.js

[Rewrite]
# 1. 独立开屏广告接口：让服务端业务状态保持原样，只清空广告内容。
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\//i then response.json.jq("if (.data | type) == \"array\" then .data = [] elif (.data | type) == \"object\" then .data = {} else . end")

# 2. 打开首页时的弹窗广告接口：不 REJECT，不碰购物券/折扣接口。
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop(?:[/?]|$)/i then response.json.jq("if (.data | type) == \"array\" then .data = [] elif (.data | type) == \"object\" then .data = {} else . end")

# 3. 首页上方「晚间市集」等独立营销横幅和悬浮位；
# 注意不删首页分类、优惠券活动或商品推荐列表。
response if ${url} ~= /^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails(?:[/?]|$)/i then response.json.delete(["data.top_advert_data", "data.suspension"])
[MitM]
hostname = maicai.api.ddxq.mobi
