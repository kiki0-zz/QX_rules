#!name=节点 IP 风险检测（Kiki版）
#!desc=v0.1 优化 Loon 实际弹窗可读性：机房/代理/VPN/Tor 单行、设备估算 0 值说明、IPPure 无效评分精简显示；长按节点检测。免 MitM。
#!author=kiki0-zz
#!tag=工具,IP检测
#!system=iOS
#!loon_version=3.5.1(983)
#!date=2026-11-14
#!homepage=https://github.com/kiki0-zz/QX_rules

# Kiki 的节点风险检测工具 v0.1。安装后在 Loon「节点」页面长按某个节点使用。
# 只在用户手动触发时请求，不后台检测、不修改分流、不启用 MITM。
# 默认使用适合 Loon 系统结果窗口的简短 HTML 速览。技术详情可在本机插件参数中开启。
# 注意：Loon 当前结果窗口对 CSS 卡片和 <details> 折叠支持有限，因此不再依赖这些元素。
# 双栈地址分别显示；东京特别区统一显示为 Tokyo（保留英文地名）。
# 共享规模仅使用 proxycheck.io device_estimate 的设备估算（不是 Ping0 共享人数）；返回 0 不视为无人共享。
# 独立使用官方 IPPure API（若其报告的出口 IP 与目标不一致，不采用风险分）。
# 不填写密钥也能使用 proxycheck.io + ipapi.is 基础查询。
# ipapi.is 匿名：每日 30 次 / 来源 IP，只有基础字段；注册免费账户可提高限额。
# proxycheck.io 匿名：每日 100 次 / 来源 IP。
# 可选 API Key 只填写到本机插件设置里，不要写进公开仓库、截图或分享的配置。
# 注意：导出或分享含 API Key 的本地配置也可能泄露密钥。

[Argument]
show_details = switch,false,type=boolean,tag=显示技术详情与接口错误,desc=默认关闭以保持一屏可读；需要排查时再打开
ipapi_key = input,"",type=string,tag=ipapi.is API Key（可选）
scamalytics_user = input,"",type=string,tag=Scamalytics 用户名（可选）
scamalytics_region = select,"EU","US",type=string,tag=Scamalytics 注册区域
scamalytics_key = input,"",type=string,tag=Scamalytics API Key（可选）
ipqs_key = input,"",type=string,tag=IPQualityScore API Key（可选）

[Script]
generic then script("https://raw.githubusercontent.com/kiki0-zz/QX_rules/main/js/ip_risk_kiki.js", {${show_details}, ${ipapi_key}, ${scamalytics_user}, ${scamalytics_region}, ${scamalytics_key}, ${ipqs_key}}) with tag="节点 IP 风险检测 · Kiki版", img_url="checkmark.shield.system", timeout=45
