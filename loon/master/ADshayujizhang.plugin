#!name=鲨鱼记账去开屏 (v4版)
#!desc=修复火山引擎 SDK 耗时请求导致的启动卡顿问题，全面覆盖所有备胎域名。
#!author=kiki

[Rule]
DOMAIN-KEYWORD, pangolin, REJECT
DOMAIN-SUFFIX, pglstatp.com, REJECT
DOMAIN-SUFFIX, pggy.com, REJECT
DOMAIN-SUFFIX, cpro.baidustatic.com, REJECT
DOMAIN-SUFFIX, pos.baidu.com, REJECT
DOMAIN-SUFFIX, adnet.qq.com, REJECT
DOMAIN-SUFFIX, umeng.com, REJECT

[Rewrite]
# 百度系
^https?:\/\/(bgg|mobads|mobads-logs|pos)\.baidu\.com reject-dict
^https?:\/\/cpro\.baidustatic\.com reject-dict

# 腾讯系
^https?:\/\/(win|v2mi|mi)\.gdt\.qq\.com reject-dict
^https?:\/\/adnet\.qq\.com reject-dict

# 穿山甲系
^https?:\/\/api-access\.pangolin-sdk-toutiao.*\.com reject-dict
^https?:\/\/.*\.pglstatp\.com reject-dict
^https?:\/\/.*\.pggy\.com reject-dict

# 友盟统计
^https?:\/\/.*\.umeng\.com reject-dict

# 🎯 新增核心：火山引擎底层 SDK (解决 2.73s 超时卡顿的真凶！)
^https?:\/\/mssdk\.volces\.com reject-dict
^https?:\/\/.*\.ctobsnssdk\.com reject-dict

[MitM]
hostname = *.pglstatp.com, *.pggy.com, cpro.baidustatic.com, pos.baidu.com, bgg.baidu.com, mobads.baidu.com, mobads-logs.baidu.com, adnet.qq.com, win.gdt.qq.com, v2mi.gdt.qq.com, api-access.pangolin-sdk-toutiao*.com, *.umeng.com, mssdk.volces.com, *.ctobsnssdk.com
