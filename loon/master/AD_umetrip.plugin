#!name=航旅纵横Pro去广告
#!desc=精准拦截航旅纵横Pro开屏广告及应用内推广，不影响行程数据。
#!author=kiki
#!tag=去广告

[Rule]
# 拦截第三方广告联盟及追踪（航旅纵横常接入的数据收集平台）
DOMAIN, ad.umetrip.com, REJECT
DOMAIN-KEYWORD, umetrip-ad, REJECT

[Rewrite]
# 核心拦截：直接掐断航旅纵横的自家开屏广告及活动弹窗下发接口
# 使用 reject-dict 安全拒绝，防止 App 报错闪退
^https?:\/\/umerp\.umetrip\.com\/gateway\/api\/umetrip\/native reject-dict
^https?:\/\/home\.umetrip\.com\/gateway\/api\/umetrip\/native reject-dict

[MitM]
# 赋予 Loon 解密这两个广告网关的权限
hostname = umerp.umetrip.com, home.umetrip.com