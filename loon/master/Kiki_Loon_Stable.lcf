[Rule]
# 私人站点和既有业务例外（保留你的分流习惯）
DOMAIN-SUFFIX,kikinode.top,DIRECT
DOMAIN-SUFFIX,kikinode.site,DIRECT
DOMAIN-SUFFIX,themoviedb.org,DIRECT
DOMAIN-SUFFIX,tmdb.org,DIRECT
DOMAIN-SUFFIX,ptzone.xyz,DIRECT
DOMAIN-SUFFIX,pomo.mom,DIRECT
DOMAIN-SUFFIX,iyzico.com,DIRECT
DOMAIN-SUFFIX,g2apay.com,DIRECT
DOMAIN,hm.baidu.com,DIRECT
DOMAIN,xs.gdt.qq.com,DIRECT
DOMAIN,ii.gdt.qq.com,DIRECT
DOMAIN-SUFFIX,ping0.cc,ping0
DOMAIN,p14-buy.itunes.apple.com,海外服务
# 使用代理兜底，不再将未命中流量强制发往日本
GEOIP,CN,DIRECT
FINAL,主代理

[Host]
# 保留常用国内域名的 DNS 指定；为避免泄露/绑定家庭网络，移除按 Wi-Fi SSID 的专用 DNS。
# 同时移除了 Google 推送服务器固定 IP 和 TestFlight 强制公共 DNS。
*.taobao.com = server:223.5.5.5
*.tmall.com = server:223.5.5.5
*.jd.com = server:119.28.28.28
*.qq.com = server:119.29.29.29
*.tencent.com = server:119.29.29.29
*.alicdn.com = server:223.5.5.5
*.aliyun.com = server:223.5.5.5
