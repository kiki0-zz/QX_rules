#!name=智行火车票去广告 (Kiki精简版)
#!desc=仅尝试过滤智行火车票开屏广告，不触碰查询、抢票、支付等业务接口；首页广告暂未适配。
#!author=kiki
#!tag=去广告, 智行火车票
#!homepage=https://github.com/kiki0-zz/QX_rules
#!date=2026-11-14

# 规则来源：奶思 fmz200 / wool_scripts，独立提取并收窄匹配。
# https://github.com/fmz200/wool_scripts
# 注意：m.ctrip.com 与携程共用，MITM 可能影响部分携程功能。
# 遇到携程图片/功能异常时，可暂时关闭本插件进行排查。

[Rewrite]
# 智行火车票：开屏广告接口（只返回空 JSON 对象）
^https?:\/\/m\.ctrip\.com\/restapi\/soa2\/13916\/scjson\/tripAds(?:\?.*)?$ reject-dict

[MitM]
hostname = m.ctrip.com
