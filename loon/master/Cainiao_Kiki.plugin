#!name=菜鸟去广告 · Kiki 极简版
#!desc=精简菜鸟 App 首页营销、商品推荐、Banner 和个人中心广告；尽量保留查件、取件、寄件。
#App链接=https://apps.apple.com/app/id951610982
#!author=kiki0-zz（参考 Moli-X / 可莉、fmz200 / 奶思公开规则）
#!tag=去广告
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Cainiao.png
#!homepage=https://github.com/kiki0-zz/QX_rules/blob/main/loon/master/Cainiao_Kiki.plugin
#!loon_version=3.5.1(978)
#!date=2026-11-14

# v1.1 | 单文件 / 无远程 JS / 不修改分流、节点、DNS 或主配置
# 参考：
# https://github.com/Moli-X/Tool/blob/X/Loon/Plugin/Kelee/Cainiao_remove_ads.plugin
# https://github.com/fmz200/wool_scripts/blob/main/Loon/plugin/split/partC/CaiNiaoGuoGuo.lpx
# 注意：启用前先关闭现有菜鸟去广告插件，防止重复重写。
# 需要 Loon 的 HTTPS 解密 / 信任证书；如发现业务异常，先停用本插件排查。
# 不封整个 cainiao.com / taobao.com；仅处理已知广告接口与广告字段。
# 菜鸟接口可能更新，无法保证所有营销元素都被去除。

[Rewrite]
# A. 广告词、广告批量位、小程序商品推荐、营销问卷与底栏推广
request if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword\.get\.cn/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(batch\.show\.v2|index)\.cn/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbopen\.miniapp\.recommend\.cpc\.cn/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbmensa\.research\.researchservice\.(acquire|event|close)\.cn/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.tabbar\.marketing\.get\.cn/i then reject_dict(200)
request if ${url} ~= /^https:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.index/i then reject_dict(200)

# B. 新版页面引擎：清掉首页营销入口、搜索推荐、活动及会员横幅
response if ${url} ~= /^https:\/\/(cn-acs\.m|e2e-mtop)\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch/i then response.json.jq("del(.data.data.data.mainSearch.bizData.searchContents, .data.data.data.operationList, .data.data.banner, .data.data.activity, .data.data.vip, .data.data.data.banner, .data.data.data.activity, .data.data.data.vip)")

# C. 旧版首页：只删活动 Banner / 促销卡片与指定营销图标
# 不清空整个 dataList，避免物流卡片丢失。
response if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.nbpresentation\.protocol\.homepage\.get\.cn/i then response.json.jq("if (.data.result.dataList | type) == \"array\" then .data.result.dataList |= map(select(((.type // \"\") | tostring | test(\"banner_area|promotion|activity_banner\")) | not) | if (((.type // \"\") | tostring | test(\"icons_scroll\")) and ((.bizData.items | type) == \"array\")) then .bizData.items |= map(. as $item | select(([\"618cjhb\",\"bgxq\",\"cncy\",\"cngy\",\"dtxb\",\"gjjf\",\"jkymd\",\"ljjq\",\"ttlhb\",\"xybg\"] | index(($item.key // \"\"))) == null)) else . end) else . end")

# D. 已知广告素材 ID：仅清理特定推荐位，不抹掉整个接口响应
response if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.mshow\.cn/i then response.json.jq("del(.data[\"10\"], .data[\"498\"], .data[\"1316\"], .data[\"1332\"], .data[\"1340\"], .data[\"1410\"], .data[\"1428\"], .data[\"1524\"], .data[\"1525\"], .data[\"1638\"], .data[\"1910\"])")

# E. 个人中心素材：去明确广告标记的横幅及娱乐推广
response if ${url} ~= /^https:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.show\.cn/i then response.json.jq("if (.data.result | type) == \"array\" then .data.result |= map(select((.materialContentMapper.adItemDetail? == null) and (.materialContentMapper.group_id? != \"common_header_banner\") and (.materialContentMapper.group_id? != \"entertainment\") and (.materialContentMapper.group_id? != \"kuaishou_banner\"))) else . end")
response if ${url} ~= /^https:\/\/(cn-acs\.m|e2e-mtop)\.cainiao\.com\/gw\/mtop\.cainiao\.app\.mine\.main/i then response.json.jq("del(.data.activity, .data.banner, .data.vip, .data.marketing)")

[MitM]
hostname = cn-acs.m.cainiao.com, e2e-mtop.cainiao.com, netflow-mtop.cainiao.com
